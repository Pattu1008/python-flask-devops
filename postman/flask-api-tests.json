
{
  "info": {
    "name": "Flask API Tests",
    "_postman_id": "7b7a4c52-1e8c-4c9b-9b3a-1b2c3d4e5f60",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://host.docker.internal:5000"
    }
  ],
  "item": [
    {
      "name": "Home endpoint returns 200",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Home endpoint returns HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Health endpoint returns healthy",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health endpoint returns HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Health status is healthy', function () {",
              "  pm.expect(pm.response.json().status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown endpoint returns 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/this-route-should-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown endpoint returns HTTP 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
